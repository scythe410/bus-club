{
  "name": "bus-club-rooms",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/ws",
      "/skin",
      "/health",
      "/radio/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BUS_ROOM",
        "class_name": "BusRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "BusRoom"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [
    {
      "pattern": "issarahatayanna.gay",
      "custom_domain": true
    },
    {
      "pattern": "www.issarahatayanna.gay",
      "custom_domain": true
    }
  ]
}
